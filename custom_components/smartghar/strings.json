  "options": {
    "step": {
      "init": {
        "title": "Voice",
        "description": "Voice-ready lets Assist see the water level, usage, last fill, pump and speaker, with spoken names. Unticking it puts exposure back the way it was.",
        "data": {
          "voice_ready": "Voice-ready: let Assist see this device",
          "voice_satellite": "Voice assistant in this integration",
          "water_arrival_times": "Water arrival times (for example 06:30, 18:00)"
        },
        "data_description": {
          "voice_satellite": "Connects to the speaker's voice assistant here, so it is one device. Unticking gives the speaker back to the stock Wyoming integration."
        }
      }
    }
  },
  "issues": {
    "stock_wyoming": {
      "title": "{name} still has a separate Wyoming device",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "One device for {name}",
            "description": "The stock Wyoming integration also controls this speaker, which would make two devices. Submit to remove the Wyoming entry. The voice assistant then appears on the SmartGhar device. Choose your assistant in the new Assistant select afterwards."
          }
        }
      }
    }
  }
