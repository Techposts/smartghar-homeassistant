          "host": "Hub IP address",
          "local_token": "Local API token (optional)"
        }
      },
      "usb": {
        "title": "USB coordinator",
        "description": "Plug the TankSync coordinator into this Home Assistant machine and enter its serial port. Prefer the stable /dev/serial/by-id/… path. Remote bridges work too (socket://host:port).",
        "data": {
          "serial_port": "Serial port or URL"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to reach the hub. Check that it's on the same network as Home Assistant and that you can ping it.",
